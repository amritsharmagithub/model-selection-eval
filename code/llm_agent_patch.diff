+
+def _sweep_extra_kwargs() -> dict:
+    """Agent-only thinking/effort overrides for parameter sweeps.
+
+    Reads TAU2_AGENT_THINKING (JSON, e.g. '{"type":"adaptive"}') and
+    TAU2_AGENT_EFFORT (e.g. 'high'). Empty/unset -> no change.
+    """
+    import json
+    import os
+
+    extra: dict = {}
+    thinking = os.environ.get("TAU2_AGENT_THINKING", "").strip()
+    effort = os.environ.get("TAU2_AGENT_EFFORT", "").strip()
+    if thinking:
+        extra["thinking"] = json.loads(thinking)
+    if effort:
+        extra["output_config"] = {"effort": effort}
+    if thinking or effort:
+        extra["temperature"] = 1
+        extra["max_tokens"] = 16000
+    if os.environ.get("TAU2_AGENT_PROMPT_CACHE", "").strip() == "1":
+        # Cache the system prompt + tools and the growing conversation prefix.
+        extra["cache_control_injection_points"] = [
+            {"location": "message", "role": "system"},
+            {"location": "message", "index": -1},
+        ]
+    return extra
+
+
